{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/pipelinr/src",
  "projectType": "application",
  "targets": {
    "build": {
      "dependsOn": [
        {
          "target": "secrets",
          "projects": "self"
        }
      ],
      "executor": "@nrwl/node:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "release",
      "options": {
        "outputPath": "dist/apps/pipelinr",
        "main": "apps/pipelinr/src/main.ts",
        "tsConfig": "apps/pipelinr/tsconfig.app.json",
        "assets": ["apps/pipelinr/src/config"],
        "webpackConfig": ["apps/pipelinr/webpack.js"]
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true,
          "vendorChunk": true,
          "inspect": true
        },
        "release": {
          "optimization": true,
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": true,
          "inspect": false
        }
      }
    },
    "serve": {
      "dependsOn": [
        {
          "target": "secrets",
          "projects": "self"
        }
      ],
      "executor": "@nrwl/node:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "pipelinr:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "pipelinr:build:development"
        },
        "release": {
          "buildTarget": "pipelinr:build:release",
          "hmr": false
        }
      }
    },
    "lint": {
      "dependsOn": [
        {
          "target": "secrets",
          "projects": "self"
        }
      ],
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/pipelinr/**/*.ts"]
      }
    },
    "test": {
      "dependsOn": [
        {
          "target": "secrets",
          "projects": "self"
        }
      ],
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/apps/pipelinr"],
      "options": {
        "jestConfig": "apps/pipelinr/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "secrets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "seki secrets generate -p=pipelinr",
        "cwd": "."
      }
    }
  },
  "tags": ["REQUIRED:GOLDEN"]
}
