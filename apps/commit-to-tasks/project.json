{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/commit-to-tasks/src",
  "projectType": "application",
  "targets": {
    "build": {
      "dependsOn": [
        {
          "target": "secrets",
          "projects": "self"
        }
      ],
      "executor": "@nrwl/node:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "release",
      "options": {
        "outputPath": "dist/apps/commit-to-tasks",
        "main": "apps/commit-to-tasks/src/main.ts",
        "tsConfig": "apps/commit-to-tasks/tsconfig.app.json",
        "assets": [
          "apps/commit-to-tasks/src/config",
          "apps/commit-to-tasks/src/templates",
          "apps/commit-to-tasks/src/db"
        ],
        "webpackConfig": ["apps/commit-to-tasks/webpack.js"]
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true,
          "vendorChunk": true,
          "inspect": true
        },
        "release": {
          "optimization": true,
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": true,
          "inspect": false
        }
      }
    },
    "serve": {
      "dependsOn": [
        {
          "target": "secrets",
          "projects": "self"
        }
      ],
      "executor": "@nrwl/node:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "commit-to-tasks:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "commit-to-tasks:build:development"
        },
        "release": {
          "buildTarget": "commit-to-tasks:build:release",
          "hmr": false
        }
      }
    },
    "lint": {
      "dependsOn": [
        {
          "target": "secrets",
          "projects": "self"
        }
      ],
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/commit-to-tasks/**/*.ts"]
      }
    },
    "test": {
      "dependsOn": [
        {
          "target": "secrets",
          "projects": "self"
        }
      ],
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/apps/commit-to-tasks"],
      "options": {
        "jestConfig": "apps/commit-to-tasks/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "secrets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "seki secrets generate -p=commit-to-tasks",
        "cwd": "."
      }
    }
  },
  "tags": ["REQUIRED:GOLDEN"]
}
